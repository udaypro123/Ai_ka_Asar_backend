NODE_ENV=development
PORT=5000
HOST=127.0.0.1
TRUST_PROXY_HOPS=0

MONGODB_URI=mongodb://localhost:27017/aimarg

# Generate independent secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Comma-separated OAuth client IDs created in Google Cloud Console (web, Android, and iOS).
GOOGLE_CLIENT_IDS=

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
AUTH_COOKIE_SAME_SITE=lax

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@aimarg.com

# Resume storage provider: local or cloudinary.
STORAGE_PROVIDER=local
STORAGE_ACCOUNT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
APP_NAME=AIMarg
API_VERSION=v1
